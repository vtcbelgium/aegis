{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://othrys.be/schemas/aegis.destructive-confirmation.v1.schema.json",
  "title": "Aegis State-Bound Destructive Confirmation (v1)",
  "description": "TOCTOU-resistant confirmation contract emitted by Aegis when an irreversible delete or destructive Git action requires exact human confirmation bound to resolved disk targets, blast-radius impact, and observed .git metadata digests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phrase", "digest", "targets", "impact", "state"],
  "properties": {
    "schema": {
      "const": "aegis.destructive-confirmation.v1"
    },
    "phrase": {
      "type": "string",
      "minLength": 24,
      "maxLength": 8192,
      "pattern": "^APPROVE DESTRUCTIVE: [a-z][a-z0-9-]{0,63} :: [^\\r\\n\\u0000*?\\[\\]]+(\\nAPPROVE DESTRUCTIVE: [a-z][a-z0-9-]{0,63} :: [^\\r\\n\\u0000*?\\[\\]]+)*$",
      "description": "Exact confirmation line(s) the human owner must type. Boolean approval buttons are forbidden for payloads matching this schema."
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 hex digest binding schema, sorted targets, observed impact, raw .git file digests, and canonical proposed action."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "target"],
        "properties": {
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\u0000*?\\[\\]]+$"
          }
        }
      }
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entries", "bytes", "complete"],
        "properties": {
          "entries": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 },
          "complete": { "type": "boolean" }
        }
      }
    },
    "state": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "head"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "head": { "type": ["string", "null"] }
        }
      }
    }
  }
}
