{
  "manifest_version": 3,
  "name": "Aegis AI Shield",
  "version": "1.0.0",
  "description": "Deterministic Negative-Gate AdBlocker & Security Firewall for AI Agents and Browsing Sessions.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aegis AI Shield"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
