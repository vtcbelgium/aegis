{
  "manifest_version": 3,
  "name": "Aegis AI Shield",
  "version": "1.1.0",
  "description": "Redacts prompt-injection text from pages and blocks exfiltration beacons before AI browsing agents read them.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aegis AI Shield"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "aegis_beacons",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
